# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.{php}]
# WordPress 代码规范约定使用 tab 缩进
indent_style = tab

[*.css]
indent_size = 2

[*.{sh,ps1,bat}]
indent_size = 2
