{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopstore.local/contracts/schemas/brand.schema.json",
  "title": "CoreBrand",
  "description": "Core Brand 是品牌档案主实体（Core 主权）。商品（Product.brand_id）归属品牌；阶段一由运营代维护，后续 Vendor Portal 自助。name 全局唯一，status 为 active / inactive。",
  "type": "object",
  "required": [
    "brand_id",
    "name",
    "status",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "brand_id": {
      "type": "string",
      "format": "uuid",
      "description": "Core 自生成品牌主键（UUID v4）。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "品牌名（全局唯一）。"
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 2000,
      "description": "品牌描述（可选）。"
    },
    "logo_url": {
      "type": ["string", "null"],
      "maxLength": 2048,
      "description": "品牌 Logo URL（可选）。"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive"],
      "description": "品牌启用状态：active（启用） / inactive（停用）。"
    },
    "created_at": {
      "$ref": "timestamp.schema.json"
    },
    "updated_at": {
      "$ref": "timestamp.schema.json"
    }
  },
  "examples": [
    {
      "brand_id": "1b2c3d4e-5f6a-7b8c-9d0e-1f2a3b4c5d6e",
      "name": "Demo Brand A",
      "description": "Demo 品牌",
      "logo_url": "https://example.test/brand-a.png",
      "status": "active",
      "created_at": "2026-09-09T03:36:27Z",
      "updated_at": "2026-09-09T03:36:27Z"
    }
  ]
}
