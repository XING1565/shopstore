# Marketplace Core 环境变量模板
# 复制为 apps/core/.env 后填写真实值；本文件只作模板，禁止填真实密钥。

# 运行环境: local / staging / prod
APP_ENV=local
APP_DEBUG=true
APP_PORT=8000

# 数据库（Core 独立数据库）
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shopstore_core
DB_USERNAME=core
DB_PASSWORD=change_me_in_env_file

# 日志
LOG_LEVEL=debug

# 与其他应用的地址（本地开发默认）
WOO_BASE_URL=http://localhost:8080
ODOO_BASE_URL=http://localhost:8069
