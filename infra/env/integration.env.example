# Integration Layer 环境变量模板
# 复制为 apps/integration/.env 后填写真实值。

APP_ENV=local
APP_DEBUG=true
APP_PORT=8100

# 连接的对外系统
WOO_BASE_URL=http://localhost:8080
ODOO_BASE_URL=http://localhost:8069
CORE_BASE_URL=http://localhost:8000

# 各系统凭据（由初始化脚本/密钥管理注入，不写死在模板）
# WOO_CONSUMER_KEY=
# WOO_CONSUMER_SECRET=
# ODOO_USER=
# ODOO_PASSWORD=

# Odoo JSON-RPC（履约轮询 worker 读交货单状态用）
ODOO_DB_NAME=shopstore_odoo
ODOO_USER=admin
# ODOO_PASSWORD=

# 同步任务
SYNC_POLL_INTERVAL_SECONDS=30
SYNC_RETRY_MAX=5
