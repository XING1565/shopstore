# WordPress / WooCommerce 环境变量模板（ISSUE-0003，config 维护）
# 复制为运行时 .env 后按需修改：
#   Copy-Item infra/env/woo.env.example apps/woo/.env
# 默认值与 apps/woo/compose.yaml 中的本地回退一致，可直接启动本地演示环境；
# 任何对外暴露或多人共享前，必须修改所有 change_me_in_env_file 密码。
# 命名遵循 docs/命名规范.md：系统私有变量带 WP_DB_* / WOO_* 前缀。

# ---- 站点 ----
# 站点 URL（写入 WP home/siteurl 选项与 `wp core install --url`）
WOO_BASE_URL=http://localhost:8080
WOO_SITE_TITLE=Shopstore Demo
# 宿主机对外端口（映射到容器 80）
WOO_PORT=8080
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=0

# ---- 数据库 ----
# Docker Compose 内主机名固定为服务名 db（apps/woo/compose.yaml）。
# WP_DB_HOST / WP_DB_PORT 仅供非容器本地运行（本地 PHP/MySQL）参考，compose 不使用。
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_NAME=shopstore_woo
WP_DB_USER=wordpress
WP_DB_PASSWORD=change_me_in_env_file
WP_DB_ROOT_PASSWORD=change_me_in_env_file
WP_DB_PREFIX=wp_

# ---- 版本（与 docs/版本清单.md / ISSUE-0002 对齐）----
# 镜像 tag 取 X.Y（与清单粒度一致）；首次联网启动后应按 upgrade 策略复核并可用 digest 收紧。
WORDPRESS_VERSION=6.9
WOOCOMMERCE_VERSION=10.8.0
MYSQL_VERSION=8.0

# ---- 测试管理员 / 测试买家（ISSUE-0003 基础账号）----
WOO_ADMIN_USER=woo_admin
WOO_ADMIN_PASSWORD=change_me_in_env_file
WOO_ADMIN_EMAIL=admin@example.test
WOO_BUYER_USERNAME=retailer_demo
WOO_BUYER_PASSWORD=change_me_in_env_file
WOO_BUYER_EMAIL=retailer_demo@example.test

# ---- 测试买家（ISSUE-0008 canonical：retailer_pending / retailer_approved）----
# 账号由 apps/woo/config/seed-test-data.php 幂等创建；用户名/邮箱固定（.test），
# 密码统一取 WOO_RETAILER_PASSWORD（不写入仓库）。
WOO_RETAILER_PASSWORD=change_me_in_env_file

# ---- 货币与地区（默认 CNY / CN，可整体覆盖）----
WOO_CURRENCY=CNY
WOO_DEFAULT_COUNTRY=CN
WOO_STORE_ADDRESS=1 Demo Road
WOO_STORE_CITY=Shanghai
WOO_STORE_POSTCODE=200000

# ---- 集成预留（后续阶段/ISSUE-0008 使用）----
# WooCommerce REST API 凭据由后续初始化生成，本阶段不写死。
# WOO_CONSUMER_KEY=
# WOO_CONSUMER_SECRET=
# marketplace-bridge 插件回调 Core 的地址
MARKETPLACE_CORE_URL=http://localhost:8000
