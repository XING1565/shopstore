# WordPress / WooCommerce 环境变量模板
# 复制为运行时 .env（如 apps/woo/.env 或 docker env 文件）后填写真实值。

# 站点地址
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_ENVIRONMENT_TYPE=local

# 数据库
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_NAME=shopstore_woo
WP_DB_USER=wordpress
WP_DB_PASSWORD=change_me_in_env_file
WP_DB_PREFIX=wp_

# WooCommerce REST API 凭据（由初始化脚本生成，不写死在模板）
# WOO_CONSUMER_KEY=
# WOO_CONSUMER_SECRET=

# marketplace-bridge 插件回调 Core 的地址
MARKETPLACE_CORE_URL=http://localhost:8000
