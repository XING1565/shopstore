# Odoo 环境变量模板（阶段 0 ISSUE-0004）
# 复制为运行时 .env（compose 项目目录 apps/odoo/config/docker/.env）后填写真实值。
# 真实值只出现在本地 .env，禁止提交进 git（.gitignore 已覆盖 .env）。

ODOO_ENV=local

# 宿主机端口映射
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# PostgreSQL 连接（compose 网络内服务名固定为 db；宿主机默认不暴露 5432）
ODOO_DB_HOST=127.0.0.1
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change_me_in_env_file
ODOO_DB_NAME=shopstore_odoo

# Odoo 网页端 master 密码（database manager：建库/备份/恢复用，初始化时使用）
ODOO_ADMIN_PASSWD=change_me_in_env_file

# 本地测试用户（admin / warehouse Odoo 登录账号）统一密码，仅供本地开发
ODOO_TEST_USER_PASSWORD=change_me_in_env_file

# 自定义模块目录（apps/odoo/addons，dev 维护；compose 只读挂载到 /mnt/extra-addons）
ODOO_ADDONS_PATH=/etc/odoo/addons,/var/lib/odoo/addons,/mnt/extra-addons
