# Odoo 环境变量模板
# 复制为运行时 .env（如 apps/odoo/.env 或 docker env 文件）后填写真实值。

ODOO_ENV=local
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# 数据库
ODOO_DB_HOST=127.0.0.1
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change_me_in_env_file
ODOO_DB_NAME=shopstore_odoo

# 管理员主密码（初始化时设置，不写死）
ODOO_ADMIN_PASSWD=change_me_in_env_file

# 自定义模块所在目录（apps/odoo/addons）
ODOO_ADDONS_PATH=/etc/odoo/addons,/var/lib/odoo/addons
